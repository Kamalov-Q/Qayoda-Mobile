{
  "expo": {
    "name": "Growen City",
    "slug": "growencity",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "growencity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.growencity.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "yandexnavi",
          "yandexmaps",
          "comgooglemaps",
          "maps"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.growencity.app",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A2024",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-emblem.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0A2024",
          "dark": {
            "backgroundColor": "#07191D"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yaqin atrofdagi e'lonlarni ko'rsatish uchun joylashuvingizdan foydalanamiz."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Suhbat va videolardagi rasm va videolarni galereyangizga saqlash uchun ruxsat kerak.",
          "photosPermission": "E'lon va suhbat uchun rasm tanlashda galereyangizdan foydalanamiz."
        }
      ],
      "react-native-compressor",
      [
        "expo-image-picker",
        {
          "photosPermission": "E'lon va suhbat uchun rasm va video tanlashda galereyangizdan foydalanamiz.",
          "cameraPermission": "Rasm va video olish uchun kameradan foydalanamiz.",
          "microphonePermission": "Video yozishda ovoz yozib olish uchun mikrofondan foydalanamiz."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0A2024",
          "defaultChannel": "default"
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-image",
      "expo-video",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/with-nav-app-queries"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1559cd9d-4855-4176-9543-09ad946d303f"
      }
    },
    "owner": "kamalovquvom",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1559cd9d-4855-4176-9543-09ad946d303f"
    }
  }
}
