# Copy to .env and fill in. .env is gitignored; this file is the checked-in
# list of what a working build needs.

EXPO_PUBLIC_API_URL=http://localhost:3001

# ---- Google sign-in ----
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# ---- Yandex Maps ----
# Two SEPARATE products, two separate keys, two separate quotas.
#
# 1. MapKit Mobile SDK — draws every map in the app.
#    BUILD-TIME: app.config.ts passes it to the config plugin, which bakes it
#    into the native binary. No EXPO_PUBLIC_ prefix, and changing it needs a
#    fresh `npx expo prebuild`. Without it, prebuild fails loudly on purpose.
YANDEX_MAPKIT_API_KEY=

# 2. Geocoder HTTP API — address search (the map search bar) and reverse
#    geocoding (the address line under the location card). Runtime, so it ships
#    in the bundle; restrict it in the Yandex console. The MapKit key is NOT
#    valid here. A new key takes up to 15 minutes to activate.
EXPO_PUBLIC_YANDEX_GEOCODER_API_KEY=

# ---- Click payments ----
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_RETURN_URL=
